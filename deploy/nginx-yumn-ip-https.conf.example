# Install after the IP certificate exists. Check existing port-443
# default_server directives first. IP clients may omit TLS SNI.
server {
    listen 443 ssl default_server;
    server_name 80.242.213.87;

    ssl_certificate /etc/letsencrypt/live/80.242.213.87/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/80.242.213.87/privkey.pem;

    add_header X-Content-Type-Options nosniff always;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
