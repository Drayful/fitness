# Example for the deployed fitness-api.service reverse proxy.
# Check existing port-80 server blocks with nginx -T before installing.
server {
    listen 80;
    server_name 80.242.213.87;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/ella_mobile/backend/public;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://80.242.213.87$request_uri;
    }
}
